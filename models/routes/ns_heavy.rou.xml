<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Approach shares of total demand: North 35%, South 35%, East 15%, West 15%. -->
    <!-- ns_heavy: 1200 veh/h, 0-3600 s; 70% straight, 15% left, 15% right. -->    
    <vType id="car" vClass="passenger" accel="2.6" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="13.89"/>

    <route id="N_straight" edges="E2 E3"/>
    <route id="N_left" edges="E2 E1"/>
    <route id="N_right" edges="E2 -E0"/>
    <route id="S_straight" edges="-E3 -E2"/>
    <route id="S_left" edges="-E3 -E0"/>
    <route id="S_right" edges="-E3 E1"/>
    <route id="E_straight" edges="-E1 -E0"/>
    <route id="E_left" edges="-E1 E3"/>
    <route id="E_right" edges="-E1 -E2"/>
    <route id="W_straight" edges="E0 E1"/>
    <route id="W_left" edges="E0 -E2"/>
    <route id="W_right" edges="E0 E3"/>

    <!-- number = 1200 * 0.35 * 0.70 -->
    <flow id="flow_N_straight" type="car" route="N_straight" begin="0" end="3600" number="294" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.35 * 0.15 -->
    <flow id="flow_N_left" type="car" route="N_left" begin="0" end="3600" number="63" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.35 * 0.15 -->
    <flow id="flow_N_right" type="car" route="N_right" begin="0" end="3600" number="63" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.35 * 0.70 -->
    <flow id="flow_S_straight" type="car" route="S_straight" begin="0" end="3600" number="294" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.35 * 0.15 -->
    <flow id="flow_S_left" type="car" route="S_left" begin="0" end="3600" number="63" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.35 * 0.15 -->
    <flow id="flow_S_right" type="car" route="S_right" begin="0" end="3600" number="63" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.15 * 0.70 -->
    <flow id="flow_E_straight" type="car" route="E_straight" begin="0" end="3600" number="126" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.15 * 0.15 -->
    <flow id="flow_E_left" type="car" route="E_left" begin="0" end="3600" number="27" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.15 * 0.15 -->
    <flow id="flow_E_right" type="car" route="E_right" begin="0" end="3600" number="27" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.15 * 0.70 -->
    <flow id="flow_W_straight" type="car" route="W_straight" begin="0" end="3600" number="126" departLane="best" departSpeed="max"/>
    <!-- number =1200 * 0.15 * 0.15 -->
    <flow id="flow_W_left" type="car" route="W_left" begin="0" end="3600" number="27" departLane="best" departSpeed="max"/>
    <!-- number = 1200 * 0.15 * 0.15 -->
    <flow id="flow_W_right" type="car" route="W_right" begin="0" end="3600" number="27" departLane="best" departSpeed="max"/>
</routes>

